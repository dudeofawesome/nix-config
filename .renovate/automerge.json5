{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Only the approved updates below may merge unattended.
  automerge: false,
  automergeType: 'pr',
  platformAutomerge: false,

  separateMinorPatch: true,

  packageRules: [
    {
      description: 'Automerge approved custom Nix package minors and patches',
      matchManagers: ['custom.regex'],
      matchDepTypes: ['custom-nix-package'],
      matchDepNames: [
        'asimov',
        'avahi2dns',
        'bosl',
        'bosl2',
        'chatgpt-desktop',
        'claude-desktop',
        'claude-pace',
        'decky-cli',
        'decky-launch-options',
        'decky-ludusavi',
        'decky-steamgriddb',
        'er-save-manager',
        'finicky',
        'git-fork',
        'gitup',
        'hammerspoon',
        'kubernetes-mcp-server',
        'launchcontrol',
        'magicpods-decky',
        'mcp-gitlab',
        'podman-mac-helper',
        'postico',
        'protondb-decky',
        'qlmarkdown',
        'qlstephen',
        'sdh-css-loader',
        'snapmaker-orca',
        'tabmaster',
        'thaw',
        'themedeck',
        'xbelite2-configurator',
      ],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
      platformAutomerge: true,
    },
    {
      // Core system inputs stay manual, including the stable and unstable groups.
      description: 'Automerge approved leaf flake input revisions',
      matchManagers: ['nix'],
      matchDepNames: [
        'claude-code-nix',
        'codex-cli-nix',
        'decky-openrgb',
        'dudeofawesome_dotfiles',
        'fish-editor-updater',
        'fish-node-binpath',
        'fish-node-version',
        'fish-nvm',
        'fish-osx',
        'fish-shell-integrations',
        'nix4vscode',
        'op-shell-plugins',
        'pslinkd',
        'upaymeifixit_dotfiles',
        'vim-lumen',
      ],
      matchUpdateTypes: ['digest', 'lockfileUpdate'],
      automerge: true,
      platformAutomerge: true,
    },
  ],
}
