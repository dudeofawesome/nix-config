{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  extends: [
    'config:best-practices',
    ':disableRateLimiting',
    'local>dudeofawesome/nix-config//.renovate/default.json5',
  ],

  // Dependabot handles flake revisions. The regex manager tracks versioned URLs.
  // Switch flake revisions back to Renovate once our runner supports per-input
  // flake.lock updates for branch URLs: https://github.com/renovatebot/renovate/pull/45258
  nix: { enabled: false },
}
