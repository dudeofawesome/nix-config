{
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.formatterPath": ["nix", "fmt", "--", "--"],
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "import (builtins.getFlake \"${workspaceFolder}\").inputs.nixpkgs-unstable { }",
      },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.haleakala.options",
        },
        "nix-darwin": {
          "expr": "(builtins.getFlake \"${workspaceFolder}\").darwinConfigurations.crater-lake.options",
        },
        "home-manager": {
          // "expr": "(builtins.getFlake \"${workspaceFolder}\").nixosConfigurations.haleakala.options.home-manager.users.type.getSubOptions []"
          // "expr": "let flake = (builtins.getFlake \"${workspaceFolder}\"); in flake.inputs.home-manager.lib.homeManagerConfiguration flake.homeConfigurations.dudeofawesome.options"
          "expr": "(builtins.getFlake \"${workspaceFolder}\").homeConfigurations.dudeofawesome.options",
        },
      },
    },
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
  },

  "[yaml]": {
    "editor.tabSize": 4,
  },
  "cSpell.words": [
    "atuin",
    "awscli",
    "binpath",
    "cachix",
    "disko",
    "distro",
    "fontis",
    "Kagi",
    "krew",
    "mkalias",
    "moar",
    "mountpoint",
    "nixfmt",
    "nixos",
    "nixpkgs",
    "pkgs",
    "raidz",
    "stdenv",
    "substituters",
    "upaymeifixit",
    "vfat",
    "wezterm",
  ],
}
