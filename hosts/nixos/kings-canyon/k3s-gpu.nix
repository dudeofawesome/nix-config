{
  config,
  lib,
  pkgs,
  ...
}:
let
  toolkit = config.hardware.nvidia-container-toolkit.package;
  driver = config.hardware.nvidia.package;
  # DRA expects conventional driver paths and binaries that run in containers.
  # Extract the same installer as the host driver without Nix's ELF patching.
  draDriverRoot =
    pkgs.runCommand "nvidia-dra-driver-root-${driver.version}"
      {
        nativeBuildInputs = with pkgs; [
          gnutar
          gzip
          xz
          zstd
          patchelf
        ];
      }
      ''
        sh ${driver.src} --extract-only --target driver
        mkdir -p "$out/bin" "$out/lib64"
        cp driver/nvidia-smi "$out/bin/"
        cp -P driver/*.so* "$out/lib64/"
        for library in "$out"/lib64/*.so*; do
          soname="$(patchelf --print-soname "$library")"
          if [ -n "$soname" ] && [ "$soname" != "$(basename "$library")" ]; then
            ln -sfn "$(basename "$library")" "$out/lib64/$soname"
          fi
        done
        test -f "$out/lib64/libnvidia-ml.so.1"
        test -f "$out/lib64/libcuda.so.1"
      '';
in
{
  hardware.nvidia-container-toolkit = {
    enable = true;
    # Keep index names for the device-plugin's current deviceIDStrategy and
    #   for rollback.
    device-name-strategy = "index";
    # doa-cluster-flux selects GPUs by UUID (its NVIDIA device plugin and
    #   RTX 3090 pods); nvidia-ctk adds these names alongside the indexes.
    #   https://github.com/dudeofawesome/doa-cluster-flux/pull/361
    extraArgs = [
      "--device-name-strategy"
      "uuid"
    ];
  };

  # K3s uses our external containerd, so its runtime auto-detection does not
  # configure this daemon. Use the CDI specification generated by NixOS.
  virtualisation.containerd.settings.plugins."io.containerd.grpc.v1.cri" = {
    enable_cdi = true;
    cdi_spec_dirs = [
      "/etc/cdi"
      "/var/run/cdi"
    ];
    containerd.runtimes.nvidia = {
      runtime_type = "io.containerd.runc.v2";
      options.BinaryName = "${lib.getOutput "tools" toolkit}/bin/nvidia-container-runtime.cdi";
    };
  };

  systemd.services.containerd = {
    requires = [ "nvidia-container-toolkit-cdi-generator.service" ];
    after = [ "nvidia-container-toolkit-cdi-generator.service" ];
  };

  # NFD advertises runtime configuration to the Flux-managed RuntimeClass.
  # Copy the file: a /nix/store symlink is not visible in the NFD container.
  environment.etc."kubernetes/node-feature-discovery/features.d/nvidia-runtime" = {
    mode = "0644";
    text = "feature.node.kubernetes.io/nvidia-runtime.configured=true\n";
  };

  # KubeAI uses DRA device-class extended resources on Kubernetes 1.35.
  services.k3s.extraFlags = [
    "--kubelet-arg=feature-gates=DRAExtendedResource=true"
  ]
  ++ lib.optionals (config.services.k3s.role == "server") [
    "--kube-apiserver-arg=feature-gates=DRAExtendedResource=true"
    "--kube-scheduler-arg=feature-gates=DRAExtendedResource=true"
    "--kube-controller-manager-arg=feature-gates=DRAExtendedResource=true"
  ];

  # Bind the tree rather than using a /nix/store symlink: the DRA pod mounts
  # its parent directory and must resolve it without mounting the Nix store.
  systemd.mounts = [
    {
      what = "${draDriverRoot}";
      where = "/run/nvidia/dra-driver";
      type = "none";
      options = "bind,ro";
      wantedBy = [ "multi-user.target" ];
      requiredBy = [ "containerd.service" ];
      before = [ "containerd.service" ];
    }
  ];

  environment.etc."kubernetes/node-feature-discovery/features.d/nvidia-dra" = {
    mode = "0644";
    text = "feature.node.kubernetes.io/nvidia-dra.configured=true\n";
  };

  # CDI hooks execute on the NixOS host, outside the workload container.
  # Give DRA a stable path to the Nix-packaged hook instead of its copied ELF.
  environment.etc."nvidia-dra/nvidia-cdi-hook".source =
    "${lib.getOutput "tools" toolkit}/bin/nvidia-cdi-hook";

  # Flux owns the RuntimeClass and GPU allocation components.
}
